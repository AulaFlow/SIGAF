SIGAF_PASS_RESPALDO=cambia_esto_respaldo
# Opcional: cada cuántos segundos (86400 = 24 h) y cuántos respaldos guardar
# SIGAF_RESPALDO_INTERVALO=86400
# SIGAF_RESPALDO_GUARDAR=7
