SIGAF_PASS_SUPER=cambia_esto_super
SIGAF_PASS_REPL=cambia_esto_repl
SIGAF_PASS_ADMIN=cambia_esto_admin
SIGAF_PASS_API=cambia_esto_api
SIGAF_PASS_ETL=cambia_esto_etl
# MongoDB (issue #8). Solo letras y números: va dentro de la URI de conexión.
SIGAF_PASS_MONGO=cambiaEstoMongo
# Respaldos (issue #26): usuario sigaf_respaldo (solo lectura)
SIGAF_PASS_RESPALDO=cambia_esto_respaldo
# Opcional: cada cuántos segundos (86400 = 24 h) y cuántos respaldos guardar
# SIGAF_RESPALDO_INTERVALO=86400
# SIGAF_RESPALDO_GUARDAR=7
# API (issue #28). Las MISMAS llaves con las que se cargaron los datos
# (reparto/limpieza): con otras, la API no puede descifrar ni buscar matrículas.
# 32+ caracteres cada una. Genera una con: openssl rand -hex 32
SIGAF_LLAVE_DATOS=cambia_esto_llave_datos_de_32_caracteres_o_mas
SIGAF_LLAVE_SEUDONIMO=cambia_esto_llave_seudonimo_de_32_caracteres_o_mas
# Llave para firmar los tokens del login (issue #11, Salva). 32+ caracteres.
SIGAF_JWT_LLAVE=cambia_esto_llave_jwt_de_32_caracteres_o_mas
# Minutos que dura el token (5 a 1440, default 60)
# SIGAF_JWT_MINUTOS=60
# Orígenes del cliente web de Flutter, separados por coma (nunca *)
# SIGAF_CORS_ORIGENES=http://localhost:8080
