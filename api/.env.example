# Copia este archivo como .env y llena los valores. .env NUNCA se sube a git.
# La API entra siempre como sigaf_api_svc y siempre con TLS.
SIGAF_PASS_API=
SIGAF_LLAVE_DATOS=
SIGAF_LLAVE_SEUDONIMO=
SIGAF_DB_HOST=localhost
SIGAF_DB_PORT=5432
SIGAF_DB_NOMBRE=postgres
SIGAF_DB_SSLMODE=require
SIGAF_DB_SSLROOTCERT=
SIGAF_DB_POOL_MAX=10
SIGAF_MONGO_URI=mongodb://localhost:27017
SIGAF_MONGO_DB=sigaf_analitica
SIGAF_CORS_ORIGENES=http://localhost:8080
